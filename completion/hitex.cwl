# hitex format
# Matthew Bertucci 2026/11/17 for v2.0

\HINTversion#*
\HINTminorversion#*
\HiTeXversion#*
\HINTimage %<= <name> <width> <height>%>#*
\HINTstartlink %<<destination>%>#*
\HINTendlink#*
\HINTdest %<<label> <placement>%>#*
\HINToutline %<<destination> <depth>%> {%<horizontal list%>}#*
\HINTsetpage %<<integer> = <name> <priority> <width> <height>%> {%<vertical list%>}#*
\HINTstream %<<integer>%>#*
\HINTbefore %<= %>{%<vertical list%>}#*
\HINTafter %<= %>{%<vertical list%>}#*

\Udelcode#*
\Udelcodenum#*
\Udelimiter#*
\Umathaccent#*
\Umathchar#*
\Umathchardef#*
\Umathchardef{cmd}#Sd
\Umathcharnum#*
\Umathcharnumdef#*
\Umathcharnumdef{cmd}#Sd
\Uradical#*